{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": null,
  "functions": {
    "api/chat.py": {
      "includeFiles": "data/index.json",
      "maxDuration": 10
    }
  },
  "headers": [
    {
      "source": "/widget.js",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=3600, stale-while-revalidate=86400" },
        { "key": "Access-Control-Allow-Origin", "value": "*" }
      ]
    }
  ]
}
